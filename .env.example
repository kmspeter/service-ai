# Application settings
APP_NAME=service-ai
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
# Readiness requires the currently exposed document-processing capability.
READINESS_REQUIRE_DOCUMENT_PROCESSING=true
DOCUMENT_STATUS_MAX_ENTRIES=10000

# Phase 14 Backend Internal API used by list_documents
# BACKEND_INTERNAL_URL=http://localhost:8080
BACKEND_INTERNAL_TIMEOUT_SECONDS=5

# Phase 02 infrastructure settings
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=replace-with-a-real-secret
# Embedding dimensions are immutable per collection; Qwen3-Embedding-8B uses 4096.
QDRANT_COLLECTION=documents_qwen3_8b_4096
QDRANT_TIMEOUT_SECONDS=5

MINIO_URL=http://localhost:9000
MINIO_ACCESS_KEY=service-ai-local
MINIO_SECRET_KEY=service-ai-local-pw
MINIO_BUCKET=documents
MINIO_TIMEOUT_SECONDS=5
MINIO_AUTO_CREATE_BUCKET=true

# Phase 03 LLM settings
# Supported: openai, ollama, gemini
LLM_PROVIDER=openai
# Provider-specific keys can coexist; LLM_PROVIDER chooses the active one.
# OPENAI_API_KEY=replace-with-a-real-secret
# OLLAMA_API_KEY=replace-with-a-real-secret
# GEMINI_API_KEY=replace-with-a-real-secret
# Legacy fallback, retained for existing environments:
# LLM_API_KEY=replace-with-a-real-secret
LLM_MODEL=replace-with-a-model-name
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=1024
# Set this to the configured model's documented context window.
# LLM_CONTEXT_WINDOW=128000
# Omit temperature to use the provider/model default.
# LLM_TEMPERATURE=0.2

# Phase 11 document summary token budget
SUMMARY_SAFETY_MARGIN_TOKENS=256

# Phase 13 multi-turn context budget
CONVERSATION_SUMMARY_MAX_OUTPUT_TOKENS=512
MAX_RECENT_MESSAGES=10

# Phase 04/07 embedding settings (independent from the LLM provider credentials)
# Supported: deepinfra, openai, huggingface
EMBEDDING_PROVIDER=deepinfra
# DeepInfra's OpenAI-compatible endpoint and provider-specific token.
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
# DEEPINFRA_API_KEY=replace-with-a-real-secret
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_TIMEOUT_SECONDS=30
# OpenAI alternative (uses OPENAI_API_KEY, with EMBEDDING_API_KEY as legacy fallback):
# EMBEDDING_PROVIDER=openai
# EMBEDDING_API_KEY=replace-with-a-real-secret
# EMBEDDING_MODEL=text-embedding-3-small
# Hugging Face alternative:
# EMBEDDING_PROVIDER=huggingface
# HF_TOKEN=replace-with-a-new-hugging-face-token
# EMBEDDING_MODEL=unsloth/Qwen3-Embedding-0.6B

# Phase 07 document ingestion settings
EMBEDDING_BATCH_SIZE=32

# Phase 09 dense vector retrieval settings
TOP_K=5
SCORE_THRESHOLD=0.5

# RAG context ceiling inside the Phase 13 final input budget
MAX_CONTEXT_TOKENS=12000

# Phase 06 token measurement and recursive chunking settings (token units)
# Qwen tokenizer is not downloaded at runtime; token budgeting uses an explicit stable encoding.
TOKENIZER_MODEL=Qwen/Qwen3-Embedding-8B
TOKENIZER_ENCODING=cl100k_base
CHUNK_SIZE=800
CHUNK_OVERLAP=100

