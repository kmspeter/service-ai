# Application settings
APP_NAME=service-ai
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000

# Phase 02 infrastructure settings
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=replace-with-a-real-secret
# Use a new collection when migrating from a 1536-dimensional OpenAI collection.
QDRANT_COLLECTION=documents_qwen3_0_6b_1024
QDRANT_TIMEOUT_SECONDS=5

MINIO_URL=http://localhost:9000
MINIO_ACCESS_KEY=replace-with-a-local-development-access-key
MINIO_SECRET_KEY=replace-with-a-local-development-secret-key
MINIO_BUCKET=documents
MINIO_TIMEOUT_SECONDS=5
MINIO_AUTO_CREATE_BUCKET=true

# Phase 03 LLM settings
# Supported: openai, ollama, gemini
LLM_PROVIDER=openai
# LLM_API_KEY=replace-with-a-real-secret
LLM_MODEL=replace-with-a-model-name
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=1024
# Omit temperature to use the provider/model default.
# LLM_TEMPERATURE=0.2

# Phase 04/07 embedding settings (independent from the LLM provider credentials)
EMBEDDING_PROVIDER=huggingface
# Use a newly issued token with Inference Providers permission. Never commit it.
# HF_TOKEN=replace-with-a-new-hugging-face-token
EMBEDDING_MODEL=unsloth/Qwen3-Embedding-0.6B
EMBEDDING_TIMEOUT_SECONDS=30
# OpenAI alternative:
# EMBEDDING_PROVIDER=openai
# EMBEDDING_API_KEY=replace-with-a-real-secret
# EMBEDDING_MODEL=text-embedding-3-small

# Phase 07 document ingestion settings
EMBEDDING_BATCH_SIZE=32

# Phase 06 token measurement and recursive chunking settings (token units)
# Qwen token measurement is not downloaded at runtime; use an explicit stable encoding.
TOKENIZER_MODEL=text-embedding-3-small
TOKENIZER_ENCODING=cl100k_base
CHUNK_SIZE=800
CHUNK_OVERLAP=100

